{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "/#portfolio",
      "permanent": true
    },
    {
      "source": "/portfolio.html",
      "destination": "/#portfolio",
      "permanent": true
    },
    {
      "source": "/seo-services-for-visa-consultancy",
      "destination": "/seo-services-visa-consultancy",
      "permanent": true
    },
    {
      "source": "/seo-services-for-visa-consultancy.html",
      "destination": "/seo-services-visa-consultancy",
      "permanent": true
    },
    {
      "source": "/geo-generative-engine-optimization-vs-traditional-seo",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/geo-generative-engine-optimization-vs-traditional-seo.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/ultimate-guide-to-wordpress-speed-optimization",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/ultimate-guide-to-wordpress-speed-optimization.html",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
