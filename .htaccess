RewriteEngine On

# Redirect /top-seo-experts-in-pakistan (without .html) to the correct page
RewriteCond %{REQUEST_URI} ^/top-seo-experts-in-pakistan/?$
RewriteRule ^top-seo-experts-in-pakistan/?$ /top-seo-experts-in-pakistan.html [R=301,L]

# Redirect explicit .html requests to extensionless URLs
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally rewrite extensionless requests to .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

